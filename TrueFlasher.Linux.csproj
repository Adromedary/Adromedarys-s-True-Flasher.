<Project Sdk="Microsoft.NET.Sdk">
  <!-- True Flasher for Linux - Made by Adromedary
       Build:  ./build.sh   (self-contained single binary, no .NET needed on the target) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>trueflasher</AssemblyName>
    <RootNamespace>TrueFlasher</RootNamespace>
    <StartupObject>TrueFlasher.LinuxProgram</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Optimize>true</Optimize>
    <Version>1.0.0</Version>
    <Company>Adromedary</Company>
    <Product>True Flasher</Product>
    <Authors>Adromedary</Authors>
    <Copyright>Copyright (c) 2026 Adromedary - MIT License</Copyright>
    <Description>Finds the real capacity of fake USB flash drives</Description>
    <NoWarn>CA1416;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Pattern.cs;src/Device.cs;src/Engine.cs;src/Report.cs;src/linux/*.cs" />
  </ItemGroup>
</Project>
